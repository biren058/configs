private static final String IN_NETWORK = "INN";
private static final String OUT_OF_NETWORK = "OON";

/**
 * Maps plan-level deductible YTD amounts into populated service-level deductibles.
 *
 * <p>Mapping is performed within each BenefitSetType only. The plan-level deductible
 * is matched to the service-level deductible using network.codeValue (for example,
 * INN or OON).</p>
 *
 * <p>If serviceLevelDeductible is null or contains no deductible amounts,
 * no YTD values are populated.</p>
 *
 * @param benefitSetTypeList benefit sets to update
 */
public void mapServiceLevelDeductibleYtd(
        final List<BenefitSetType> benefitSetTypeList) {

    if (benefitSetTypeList == null || benefitSetTypeList.isEmpty()) {
        return;
    }

    benefitSetTypeList.stream()
            .filter(Objects::nonNull)
            .forEach(this::mapBenefitSetDeductibleYtd);
}

private void mapBenefitSetDeductibleYtd(final BenefitSetType benefitSet) {

    final Map<String, DeductibleYtd> ytdByNetwork =
            buildPlanLevelYtdByNetwork(benefitSet);

    if (ytdByNetwork.isEmpty()) {
        return;
    }

    final ServiceLevelBenefitSetType serviceLevelBenefitSet =
            benefitSet.getServiceLevelBenefitSet();

    if (serviceLevelBenefitSet == null
            || serviceLevelBenefitSet.getServiceBenefits() == null) {
        return;
    }

    serviceLevelBenefitSet.getServiceBenefits().stream()
            .filter(Objects::nonNull)
            .map(ServiceBenefitType::getServiceBenefitLevels)
            .filter(Objects::nonNull)
            .flatMap(Collection::stream)
            .filter(Objects::nonNull)
            .forEach(serviceBenefitLevel ->
                    mapServiceBenefitLevelYtd(serviceBenefitLevel, ytdByNetwork));
}

/**
 * Creates:
 *
 * INN -> (familyYtd, individualYtd)
 * OON -> (familyYtd, individualYtd)
 */
private Map<String, DeductibleYtd> buildPlanLevelYtdByNetwork(
        final BenefitSetType benefitSet) {

    final PlanLevelBenefitSetType planLevelBenefitSet =
            benefitSet.getPlanLevelBenefitSet();

    if (planLevelBenefitSet == null
            || planLevelBenefitSet.getPlanBenefitLevels() == null) {
        return Map.of();
    }

    final Map<String, DeductibleYtd> ytdByNetwork = new HashMap<>();

    planLevelBenefitSet.getPlanBenefitLevels().stream()
            .filter(Objects::nonNull)
            .forEach(planBenefitLevel ->
                    addPlanLevelYtd(planBenefitLevel, ytdByNetwork));

    return ytdByNetwork;
}

private void addPlanLevelYtd(
        final PlanBenefitLevelType planBenefitLevel,
        final Map<String, DeductibleYtd> ytdByNetwork) {

    final String networkCode = getNetworkCode(planBenefitLevel.getNetwork());

    if (networkCode == null
            || planBenefitLevel.getPlanLevelDeductibles() == null) {
        return;
    }

    planBenefitLevel.getPlanLevelDeductibles().stream()
            .filter(Objects::nonNull)
            .findFirst()
            .ifPresent(deductible -> ytdByNetwork.put(
                    networkCode,
                    new DeductibleYtd(
                            deductible.getYTDAccumulatedFamilyDeductibleAmount(),
                            deductible.getYTDAccumulatedIndividualDeductibleAmount()
                    )
            ));
}

private void mapServiceBenefitLevelYtd(
        final ServiceBenefitLevelType serviceBenefitLevel,
        final Map<String, DeductibleYtd> ytdByNetwork) {

    final ServiceLevelDeductibleType serviceLevelDeductible =
            serviceBenefitLevel.getServiceLevelDeductible();

    // JSON: "serviceLevelDeductible": {}
    // Nothing to map.
    if (!hasDeductible(serviceLevelDeductible)) {
        return;
    }

    final String networkCode =
            getNetworkCode(serviceBenefitLevel.getNetwork());

    if (networkCode == null) {
        return;
    }

    final DeductibleYtd ytd = ytdByNetwork.get(networkCode);

    if (ytd == null) {
        return;
    }

    mapYtdAmounts(serviceLevelDeductible, ytd);
}

private void mapYtdAmounts(
        final ServiceLevelDeductibleType serviceLevelDeductible,
        final DeductibleYtd ytd) {

    /*
     * Map family YTD only when this service-level deductible
     * actually has a family deductible.
     */
    if (serviceLevelDeductible.getFamilyDeductibleAmount() != null) {
        serviceLevelDeductible.setYTDAccumulatedFamilyDeductibleAmount(
                ytd.familyAmount()
        );
    }

    /*
     * Map individual YTD only when this service-level deductible
     * actually has an individual deductible.
     */
    if (serviceLevelDeductible.getIndividualDeductibleAmount() != null) {
        serviceLevelDeductible.setYTDAccumulatedIndividualDeductibleAmount(
                ytd.individualAmount()
        );
    }
}

private boolean hasDeductible(
        final ServiceLevelDeductibleType deductible) {

    return deductible != null
            && (deductible.getFamilyDeductibleAmount() != null
            || deductible.getIndividualDeductibleAmount() != null);
}

private String getNetworkCode(final CodeDescPairType network) {

    if (network == null || network.getCodeValue() == null) {
        return null;
    }

    final String networkCode = network.getCodeValue().trim();

    if (networkCode.isEmpty()) {
        return null;
    }

    /*
     * Normalize because "INN", "inn", " INN " should all
     * resolve to the same lookup value.
     */
    return networkCode.toUpperCase(Locale.ROOT);
}

/**
 * Immutable internal value object containing only the values
 * required during mapping.
 */
private record DeductibleYtd(
        String familyAmount,
        String individualAmount) {
}
