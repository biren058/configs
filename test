package com.uhg.payer.product.utils

import com.uhg.payer.product.exception.TokenException
import com.uhg.payer.product.validation.ValidationUtils
import spock.lang.Specification
import spock.lang.Unroll

import java.util.concurrent.atomic.AtomicReference

class ValidationUtilsSpec extends Specification {

    @Unroll
    def "formatStringMoney should convert '#money' to '#expectedResult'"() {
        given:
        def validationUtils = new ValidationUtils()

        when:
        String result = validationUtils.formatStringMoney(money)

        then:
        result == expectedResult

        where:
        money        || expectedResult
        "1000"       || "1000.00"
        "100"        || "100.00"
        "1"          || "1.00"

        "0"          || "0.00"
        "0.0"        || "0.00"
        "0.00"       || "0.00"
        "0.000"      || "0.00"

        "-0"         || "0.00"
        "-0.0"       || "0.00"
        "-0.00"      || "0.00"
        "-0.000"     || "0.00"

        "1.1"        || "1.10"
        "10.5"       || "10.50"
        "100.25"     || "100.25"
        "999.99"     || "999.99"

        "-1"         || "-1.00"
        "-1.5"       || "-1.50"
        "-10.50"     || "-10.50"
        "-999.99"    || "-999.99"

        "0.01"       || "0.01"
        "-0.01"      || "-0.01"

        "1000000"    || "1000000.00"
        "9999999.99" || "9999999.99"
    }


    @Unroll
    def "formatStringMoney should safely handle invalid input '#money'"() {
        given:
        def validationUtils = new ValidationUtils()

        when:
        String result = validationUtils.formatStringMoney(money)

        then:
        noExceptionThrown()
        result == expectedResult

        where:
        money   || expectedResult
        null    || null
        ""      || ""
        " "     || " "
        "abc"   || "abc"
        "10abc" || "10abc"
        "--1"   || "--1"
    }


    @Unroll
    def "formatStringMoney should handle surrounding whitespace '#money'"() {
        given:
        def validationUtils = new ValidationUtils()

        when:
        String result = validationUtils.formatStringMoney(money)

        then:
        result == expectedResult

        where:
        money       || expectedResult
        " 100 "     || "100.00"
        " 10.50 "   || "10.50"
        " -0.00 "   || "0.00"
        " -10.50 "  || "-10.50"
    }


    def "getCqlAuthorization should return bearer authorization when token is available"() {
        given:
        def validationUtils = new ValidationUtils()

        def tokenController = Mock(GraphQlOAuthTokenController)

        validationUtils.graphQlOAuthTokenController = tokenController

        tokenController.getCqlOAuthToken() >>
                new AtomicReference<String>("test-access-token")

        when:
        String result = validationUtils.getCqlAuthorization()

        then:
        result == OAuthConstants.BEARER.getValue() + "test-access-token"

        and:
        1 * tokenController.getCqlOAuthToken()
    }


    def "getCqlAuthorization should throw TokenException when token reference is null"() {
        given:
        def validationUtils = new ValidationUtils()

        def tokenController = Mock(GraphQlOAuthTokenController)

        validationUtils.graphQlOAuthTokenController = tokenController

        tokenController.getCqlOAuthToken() >> null

        when:
        validationUtils.getCqlAuthorization()

        then:
        thrown(TokenException)

        and:
        1 * tokenController.getCqlOAuthToken()
    }


    def "getCqlAuthorization should handle AtomicReference containing null token"() {
        given:
        def validationUtils = new ValidationUtils()

        def tokenController = Mock(GraphQlOAuthTokenController)

        validationUtils.graphQlOAuthTokenController = tokenController

        tokenController.getCqlOAuthToken() >>
                new AtomicReference<String>(null)

        when:
        String result = validationUtils.getCqlAuthorization()

        then:
        result == OAuthConstants.BEARER.getValue() + null

        and:
        1 * tokenController.getCqlOAuthToken()
    }
}
