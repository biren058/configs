import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.util.regex.Pattern;

public final class HipaaCodeValidator {

    private static final String DELIMITER = ":";

    private static final Pattern BASIC_DATE_PATTERN =
            Pattern.compile("\\d{8}");

    private static final DateTimeFormatter INPUT_DATE_FORMATTER =
            DateTimeFormatter.BASIC_ISO_DATE;

    private static final DateTimeFormatter OUTPUT_DATE_FORMATTER =
            DateTimeFormatter.ISO_LOCAL_DATE;

    private HipaaCodeValidator() {
        // Utility class
    }

    public static boolean isValidHipaaCode(
            final String serviceTypeName,
            final CoverageDates coverageDates) {

        if (serviceTypeName == null || serviceTypeName.isBlank()) {
            return true;
        }

        final DateExtractionResult extractionResult =
                extractDateRange(serviceTypeName);

        if (extractionResult.status() == DateStatus.NO_DATES) {
            return true;
        }

        if (extractionResult.status() == DateStatus.INVALID_DATES
                || coverageDates == null
                || coverageDates.getStart() == null
                || coverageDates.getEnd() == null) {
            return false;
        }

        final ServiceTypeDateRange dateRange =
                extractionResult.dateRange();

        return DateRangeUtils.isDateWithinRange(
                coverageDates.getStart(),
                coverageDates.getEnd(),
                dateRange.startDate(),
                dateRange.endDate()
        );
    }

    private static DateExtractionResult extractDateRange(
            final String serviceTypeName) {

        final String[] parts = serviceTypeName.split(DELIMITER, -1);

        for (int index = 0; index < parts.length - 1; index++) {

            final String startCandidate = parts[index].trim();
            final String endCandidate = parts[index + 1].trim();

            if (!isDateCandidate(startCandidate)
                    || !isDateCandidate(endCandidate)) {
                continue;
            }

            return parseDateRange(startCandidate, endCandidate);
        }

        return DateExtractionResult.noDates();
    }

    private static boolean isDateCandidate(final String value) {
        return BASIC_DATE_PATTERN.matcher(value).matches();
    }

    private static DateExtractionResult parseDateRange(
            final String startDate,
            final String endDate) {

        try {
            final LocalDate parsedStartDate =
                    LocalDate.parse(startDate, INPUT_DATE_FORMATTER);

            final LocalDate parsedEndDate =
                    LocalDate.parse(endDate, INPUT_DATE_FORMATTER);

            if (parsedStartDate.isAfter(parsedEndDate)) {
                return DateExtractionResult.invalidDates();
            }

            return DateExtractionResult.valid(
                    new ServiceTypeDateRange(
                            parsedStartDate.format(OUTPUT_DATE_FORMATTER),
                            parsedEndDate.format(OUTPUT_DATE_FORMATTER)
                    )
            );

        } catch (DateTimeParseException exception) {
            return DateExtractionResult.invalidDates();
        }
    }

    private enum DateStatus {
        NO_DATES,
        VALID_DATES,
        INVALID_DATES
    }

    private record ServiceTypeDateRange(
            String startDate,
            String endDate) {
    }

    private record DateExtractionResult(
            DateStatus status,
            ServiceTypeDateRange dateRange) {

        private static DateExtractionResult noDates() {
            return new DateExtractionResult(
                    DateStatus.NO_DATES,
                    null
            );
        }

        private static DateExtractionResult invalidDates() {
            return new DateExtractionResult(
                    DateStatus.INVALID_DATES,
                    null
            );
        }

        private static DateExtractionResult valid(
                final ServiceTypeDateRange dateRange) {

            return new DateExtractionResult(
                    DateStatus.VALID_DATES,
                    dateRange
            );
        }
    }
}
