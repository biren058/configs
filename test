package com.example.service;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import java.util.Collections;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Optional;
import java.util.Set;

@Component
public class CosmosGroupCodeMatcher {

    private static final String DELIMITER = ":";
    private static final int EXPECTED_PARTS = 3;

    private static final Set<String> TRUE_WHEN_DIFFERENT =
            Set.of("NTL", "OEB");

    private static final Set<String> TRUE_WHEN_MATCH =
            Set.of("BNA", "OHO");

    private static final Set<String> SUPPORTED_PREFIXES =
            Set.of("NTL", "OEB", "BNA", "OHO");

    private final Map<String, Set<String>> cosmosCodesByPrefix;

    public CosmosGroupCodeMatcher(
            @Value("${cosmos.group-codes:}") List<String> cosmosGroupCodes) {

        this.cosmosCodesByPrefix =
                buildLookupMap(cosmosGroupCodes);
    }

    public boolean matches(String planGroupCode) {

        Optional<GroupCode> parsedPlanGroupCode =
                parseGroupCode(planGroupCode);

        if (parsedPlanGroupCode.isEmpty()) {
            return false;
        }

        GroupCode planCode = parsedPlanGroupCode.get();

        Set<String> configuredCodeAndDates =
                cosmosCodesByPrefix.getOrDefault(
                        planCode.prefix(),
                        Collections.emptySet()
                );

        /*
         * Prefix must exist in the configured Cosmos group codes.
         */
        if (configuredCodeAndDates.isEmpty()) {
            return false;
        }

        boolean codeAndDateMatch =
                configuredCodeAndDates.contains(
                        buildCodeAndDateKey(
                                planCode.code(),
                                planCode.date()
                        )
                );

        /*
         * BNA / OHO:
         * return true only when CODE + DATE match.
         */
        if (TRUE_WHEN_MATCH.contains(planCode.prefix())) {
            return codeAndDateMatch;
        }

        /*
         * NTL / OEB:
         * return true only when CODE + DATE do not match.
         */
        if (TRUE_WHEN_DIFFERENT.contains(planCode.prefix())) {
            return !codeAndDateMatch;
        }

        return false;
    }

    private static Map<String, Set<String>> buildLookupMap(
            List<String> cosmosGroupCodes) {

        if (cosmosGroupCodes == null || cosmosGroupCodes.isEmpty()) {
            return Collections.emptyMap();
        }

        Map<String, Set<String>> lookup = new HashMap<>();

        for (String cosmosGroupCode : cosmosGroupCodes) {

            Optional<GroupCode> parsedGroupCode =
                    parseGroupCode(cosmosGroupCode);

            if (parsedGroupCode.isEmpty()) {
                continue;
            }

            GroupCode groupCode = parsedGroupCode.get();

            lookup.computeIfAbsent(
                            groupCode.prefix(),
                            key -> new HashSet<>()
                    )
                    .add(
                            buildCodeAndDateKey(
                                    groupCode.code(),
                                    groupCode.date()
                            )
                    );
        }

        Map<String, Set<String>> immutableLookup = new HashMap<>();

        lookup.forEach(
                (prefix, values) ->
                        immutableLookup.put(
                                prefix,
                                Set.copyOf(values)
                        )
        );

        return Map.copyOf(immutableLookup);
    }

    private static Optional<GroupCode> parseGroupCode(String groupCode) {

        if (groupCode == null || groupCode.isBlank()) {
            return Optional.empty();
        }

        String[] parts =
                groupCode.split(DELIMITER, -1);

        if (parts.length != EXPECTED_PARTS) {
            return Optional.empty();
        }

        String prefix =
                parts[0].trim().toUpperCase(Locale.ROOT);

        String code =
                parts[1].trim();

        String date =
                parts[2].trim();

        if (prefix.isEmpty()
                || code.isEmpty()
                || date.isEmpty()
                || !SUPPORTED_PREFIXES.contains(prefix)) {

            return Optional.empty();
        }

        return Optional.of(
                new GroupCode(
                        prefix,
                        code,
                        date
                )
        );
    }

    private static String buildCodeAndDateKey(
            String code,
            String date) {

        return code + DELIMITER + date;
    }

    private record GroupCode(
            String prefix,
            String code,
            String date) {
    }
}
