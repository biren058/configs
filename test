def "buildPlanLevelYtdByNetwork should create YTD entries for INN OON and COMB"() {
    given:
    def benefitSet = Mock(BenefitSetType)
    def planLevelSet = Mock(PlanLevelBenefitSetType)

    def innLevel = Mock(PlanBenefitLevelType)
    def oonLevel = Mock(PlanBenefitLevelType)
    def combLevel = Mock(PlanBenefitLevelType)

    def innNetwork = Mock(CodeDescPairType)
    def oonNetwork = Mock(CodeDescPairType)
    def combNetwork = Mock(CodeDescPairType)

    def innDeductible = Mock(PlanLevelDeductibleType)
    def oonDeductible = Mock(PlanLevelDeductibleType)
    def combDeductible = Mock(PlanLevelDeductibleType)

    benefitSet.getPlanLevelBenefitSet() >> planLevelSet
    planLevelSet.getPlanBenefitLevels() >> [innLevel, oonLevel, combLevel]

    innLevel.getNetwork() >> innNetwork
    innNetwork.getCodeValue() >> "INN"
    innLevel.getPlanLevelDeductibles() >> [innDeductible]

    oonLevel.getNetwork() >> oonNetwork
    oonNetwork.getCodeValue() >> "OON"
    oonLevel.getPlanLevelDeductibles() >> [oonDeductible]

    combLevel.getNetwork() >> combNetwork
    combNetwork.getCodeValue() >> "COMB"
    combLevel.getPlanLevelDeductibles() >> [combDeductible]

    innDeductible.getYTDAccumulatedFamilyDeductibleAmount() >> "1000.00"
    innDeductible.getYTDAccumulatedIndividualDeductibleAmount() >> "500.00"

    oonDeductible.getYTDAccumulatedFamilyDeductibleAmount() >> "2000.00"
    oonDeductible.getYTDAccumulatedIndividualDeductibleAmount() >> "1000.00"

    combDeductible.getYTDAccumulatedFamilyDeductibleAmount() >> "3000.00"
    combDeductible.getYTDAccumulatedIndividualDeductibleAmount() >> "1500.00"

    when:
    Map result = (Map) invoke(
            "buildPlanLevelYtdByNetwork",
            [BenefitSetType] as Class[],
            [benefitSet] as Object[]
    )

    then:
    result.size() == 3
    result.containsKey("INN")
    result.containsKey("OON")
    result.containsKey("COMB")
}


