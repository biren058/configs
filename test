def "getGqlAuthorization should return bearer authorization when token is available"() {
    given:
    def tokenController = Mock(GraphQlOAuthTokenController)
    def validationUtils = new ValidationUtils()

    validationUtils.graphQlOAuthTokenController = tokenController

    and:
    def token = new AtomicReference<String>("test-access-token")

    // IMPORTANT: stub before executing the method
    tokenController.getCqlOAuthToken() >> token

    when:
    String result = validationUtils.getGqlAuthorization()

    then:
    result == OAuthConstants.BEARER.getValue() + "test-access-token"
}


def "getGqlAuthorization should throw TokenException when token reference is null"() {
    given:
    def tokenController = Mock(GraphQlOAuthTokenController)
    def validationUtils = new ValidationUtils()

    validationUtils.graphQlOAuthTokenController = tokenController

    and:
    // IMPORTANT: explicitly return null
    tokenController.getCqlOAuthToken() >> null

    when:
    validationUtils.getGqlAuthorization()

    then:
    thrown(TokenException)
}


