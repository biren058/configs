def "isNetworkCodeMatching should match INN and OON using regular network code"() {
    given:
    def planCostShare = Mock(PlanCostShare)
    def level = Mock(PlanBenefitLevelType)
    def network = Mock(CodeDescPairType)

    planCostShare.getCostShareNetworkTypeCode() >> requestedCode
    level.getNetwork() >> network
    network.getCodeValue() >> levelCode

    expect:
    invoke(
            "isNetworkCodeMatching",
            [PlanCostShare, PlanBenefitLevelType] as Class[],
            [planCostShare, level] as Object[]
    ) == expected

    where:
    requestedCode | levelCode || expected
    "INN"         | "INN"     || true
    "OON"         | "OON"     || true
    "INN"         | "OON"     || false
    "OON"         | "INN"     || false
