package com.example.service;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import java.util.Collections;
import java.util.EnumMap;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Optional;
import java.util.Set;

@Component
public class CosmosGroupCodeMatcher {

    private static final String DELIMITER = ":";
    private static final int MINIMUM_REQUIRED_PARTS = 3;
    private static final int SPLIT_LIMIT = 4;

    /*
     * ALPHA RULES
     *
     * MATCH_REQUIRED_PREFIXES    : BNA, OHO
     * MISMATCH_REQUIRED_PREFIXES : NTL, OEB
     * MISMATCHED_PREFIXES        : CAL, MSP, MEC, FLA, PPL, MTK
     */
    private static final PrefixRules ALPHA_RULES = new PrefixRules(
            Set.of("BNA", "OHO"),
            Set.of("NTL", "OEB"),
            Set.of("CAL", "MSP", "MEC", "FLA", "PPL", "MTK")
    );

    /*
     * BRAVO RULES
     *
     * MATCH_REQUIRED_PREFIXES    : SLC, BNA, OEB, PNX, BHM
     * MISMATCH_REQUIRED_PREFIXES : OHO
     * MISMATCHED_PREFIXES        : ATL, CAL, CHS, ETX, FLA, GSO,
     *                              KLC, MPC, NEX, NTL, NYC, PPL,
     *                              PVS, RAM, STM
     */
    private static final PrefixRules BRAVO_RULES = new PrefixRules(
            Set.of("SLC", "BNA", "OEB", "PNX", "BHM"),
            Set.of("OHO"),
            Set.of(
                    "ATL", "CAL", "CHS", "ETX", "FLA",
                    "GSO", "KLC", "MPC", "NEX", "NTL",
                    "NYC", "PPL", "PVS", "RAM", "STM"
            )
    );

    private final Map<GroupCodeType, PrefixRules> rulesByType;
    private final Map<GroupCodeType, Map<String, Set<String>>> cosmosCodesByType;

    public CosmosGroupCodeMatcher(
            @Value("${cosmos.group-codes.alpha:}") List<String> alphaGroupCodes,
            @Value("${cosmos.group-codes.bravo:}") List<String> bravoGroupCodes) {

        this.rulesByType = createRules();

        Map<GroupCodeType, Map<String, Set<String>>> lookup =
                new EnumMap<>(GroupCodeType.class);

        lookup.put(
                GroupCodeType.ALPHA,
                buildLookupMap(
                        alphaGroupCodes,
                        ALPHA_RULES.specialPrefixes()
                )
        );

        lookup.put(
                GroupCodeType.BRAVO,
                buildLookupMap(
                        bravoGroupCodes,
                        BRAVO_RULES.specialPrefixes()
                )
        );

        this.cosmosCodesByType = Map.copyOf(lookup);
    }

    /**
     * Validates a plan group code using the business rules associated
     * with the supplied Cosmos group-code type.
     *
     * <p>Expected minimum format: {@code PREFIX:CODE:DATE}.
     * Additional attributes after DATE are ignored.</p>
     *
     * <p>Examples:</p>
     * <pre>
     * BNA:90330:20220303
     * BNA:90330:20220303:M:008
     * </pre>
     *
     * @param planGroupCode plan group code
     * @param groupCodeType ALPHA or BRAVO
     * @return true when the plan group code satisfies the applicable rule;
     *         otherwise false
     */
    public boolean matches(
            String planGroupCode,
            GroupCodeType groupCodeType) {

        if (groupCodeType == null) {
            return false;
        }

        Optional<GroupCode> parsedPlanGroupCode =
                parseGroupCode(planGroupCode);

        if (parsedPlanGroupCode.isEmpty()) {
            return false;
        }

        PrefixRules rules = rulesByType.get(groupCodeType);

        if (rules == null) {
            return false;
        }

        GroupCode planCode = parsedPlanGroupCode.get();
        String prefix = planCode.prefix();

        /*
         * Known mismatched prefixes always return false.
         */
        if (rules.mismatchedPrefixes().contains(prefix)) {
            return false;
        }

        /*
         * Prefix does not require any special Cosmos comparison.
         */
        if (!rules.specialPrefixes().contains(prefix)) {
            return true;
        }

        Map<String, Set<String>> cosmosCodesByPrefix =
                cosmosCodesByType.getOrDefault(
                        groupCodeType,
                        Collections.emptyMap()
                );

        Set<String> configuredCodeAndDates =
                cosmosCodesByPrefix.getOrDefault(
                        prefix,
                        Collections.emptySet()
                );

        /*
         * Special prefix must have Cosmos configuration.
         */
        if (configuredCodeAndDates.isEmpty()) {
            return false;
        }

        boolean codeAndDateMatch =
                configuredCodeAndDates.contains(
                        buildCodeAndDateKey(
                                planCode.code(),
                                planCode.date()
                        )
                );

        /*
         * ALPHA:
         *   BNA/OHO -> true when CODE + DATE match.
         *
         * BRAVO:
         *   SLC/BNA/OEB/PNX/BHM -> true when CODE + DATE match.
         */
        if (rules.matchRequiredPrefixes().contains(prefix)) {
            return codeAndDateMatch;
        }

        /*
         * ALPHA:
         *   NTL/OEB -> true when CODE + DATE do NOT match.
         *
         * BRAVO:
         *   OHO -> true when CODE + DATE does NOT match.
         */
        return !codeAndDateMatch;
    }

    /*
     * Optional convenience method to preserve existing ALPHA behavior.
     *
     * Existing calls:
     * cosmosGroupCodeMatcher.matches(planGroupCode)
     *
     * will continue to use ALPHA.
     */
    public boolean matches(String planGroupCode) {
        return matches(planGroupCode, GroupCodeType.ALPHA);
    }

    private static Map<GroupCodeType, PrefixRules> createRules() {

        Map<GroupCodeType, PrefixRules> rules =
                new EnumMap<>(GroupCodeType.class);

        rules.put(GroupCodeType.ALPHA, ALPHA_RULES);
        rules.put(GroupCodeType.BRAVO, BRAVO_RULES);

        return Map.copyOf(rules);
    }

    private static Map<String, Set<String>> buildLookupMap(
            List<String> cosmosGroupCodes,
            Set<String> specialPrefixes) {

        if (cosmosGroupCodes == null || cosmosGroupCodes.isEmpty()) {
            return Collections.emptyMap();
        }

        Map<String, Set<String>> lookup = new HashMap<>();

        for (String cosmosGroupCode : cosmosGroupCodes) {

            Optional<GroupCode> parsedGroupCode =
                    parseGroupCode(cosmosGroupCode);

            if (parsedGroupCode.isEmpty()) {
                continue;
            }

            GroupCode groupCode = parsedGroupCode.get();

            /*
             * Only prefixes requiring CODE + DATE comparison
             * need to be stored in the lookup map.
             */
            if (!specialPrefixes.contains(groupCode.prefix())) {
                continue;
            }

            lookup.computeIfAbsent(
                            groupCode.prefix(),
                            ignored -> new HashSet<>()
                    )
                    .add(
                            buildCodeAndDateKey(
                                    groupCode.code(),
                                    groupCode.date()
                            )
                    );
        }

        Map<String, Set<String>> immutableLookup = new HashMap<>();

        lookup.forEach(
                (prefix, values) ->
                        immutableLookup.put(
                                prefix,
                                Set.copyOf(values)
                        )
        );

        return Map.copyOf(immutableLookup);
    }

    /*
     * Parses only the structure.
     *
     * It intentionally does NOT validate prefix business rules because
     * the same parser is used for ALPHA, BRAVO and incoming plan codes.
     *
     * BNA:90330:20220303
     * -> BNA / 90330 / 20220303
     *
     * BNA:90330:20220303:M:008
     * -> BNA / 90330 / 20220303
     */
    private static Optional<GroupCode> parseGroupCode(String groupCode) {

        if (groupCode == null || groupCode.isBlank()) {
            return Optional.empty();
        }

        String[] parts =
                groupCode.split(DELIMITER, SPLIT_LIMIT);

        if (parts.length < MINIMUM_REQUIRED_PARTS) {
            return Optional.empty();
        }

        String prefix =
                parts[0].trim().toUpperCase(Locale.ROOT);

        String code =
                parts[1].trim();

        String date =
                parts[2].trim();

        if (prefix.isEmpty()
                || code.isEmpty()
                || date.isEmpty()) {

            return Optional.empty();
        }

        return Optional.of(
                new GroupCode(
                        prefix,
                        code,
                        date
                )
        );
    }

    private static String buildCodeAndDateKey(
            String code,
            String date) {

        return code + DELIMITER + date;
    }

    public enum GroupCodeType {
        ALPHA,
        BRAVO
    }

    private record PrefixRules(
            Set<String> matchRequiredPrefixes,
            Set<String> mismatchRequiredPrefixes,
            Set<String> mismatchedPrefixes) {

        private PrefixRules {
            matchRequiredPrefixes =
                    Set.copyOf(matchRequiredPrefixes);

            mismatchRequiredPrefixes =
                    Set.copyOf(mismatchRequiredPrefixes);

            mismatchedPrefixes =
                    Set.copyOf(mismatchedPrefixes);
        }

        private Set<String> specialPrefixes() {

            Set<String> prefixes = new HashSet<>(
                    matchRequiredPrefixes
            );

            prefixes.addAll(
                    mismatchRequiredPrefixes
            );

            return Set.copyOf(prefixes);
        }
    }

    private record GroupCode(
            String prefix,
            String code,
            String date) {
    }
}
